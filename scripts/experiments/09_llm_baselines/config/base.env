# Common settings: identical to 05_few_shot (Llama few-shot row), except NUM_SHARDS=1 and no quantization.
INPUT_JSONL=${REPO_ROOT}/data/processed/simulation/simu_progress_notes.jsonl
PROMPT_FILE=${PROMPT_FILE:-${REPO_ROOT}/src/prompts/gen_annotation_noae_v2.toml}
GUIDELINE_PATH=
USE_ADAPTER=false
ICL_ENABLED=true
ICL_INPUT_DIR=${REPO_ROOT}/data/raw/contexts/simu_progress_notes
ICL_OUTPUT_DIR=${REPO_ROOT}/data/raw/contexts/simu_annotation_noae
N_CONTEXT=2
ICL_SEED=42
NUM_SHARDS=1
MAX_INPUT_LENGTH=17000
MAX_NEW_TOKENS=${MAX_NEW_TOKENS:-4096}
TEMPERATURE=0.0
TOP_P=1.0
REPETITION_PENALTY=1.0
MAX_EVENTS=64
BATCH_SIZE=1
RESUME=true
ID_KEY=id
INPUT_KEY=progress_note
PRED_KEY=pred_annotation
RAW_PRED_KEY=raw_pred_annotation
OUT_SUBDIR=inference
OUT_BASENAME=pred
SPLIT=raw
# --- new options (read by src/inferpipe) ---
QUANT=none                 # nf4 | none  (none = load in bf16 / model's own quantization config)
REASONING_EFFORT=low       # passed to harmony chat template when supported
FINAL_CHANNEL=true         # extract <|channel|>final<|message|> ... <|return|> as the prediction
ATTN_IMPL=eager            # gpt-oss: no sdpa kernel; flex_attention fails across multi-GPU device_map; eager is query-chunked in src/inferpipe/modeling.py
ATTN_CHUNK=1024
GPU_HEADROOM_GB=12
